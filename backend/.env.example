# ─────────────────────────────────────────────────────────────────────────────
# Configuración del backend del asistente. Copia este archivo a `.env` y rellena.
# NUNCA subas el .env real al repo (está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Proveedor de LLM ─────────────────────────────────────────────────────────
# "anthropic" (por defecto) o "openai".
LLM_PROVIDER=anthropic

# ── Modelo ───────────────────────────────────────────────────────────────────
# Por defecto: claude-opus-5 (máxima calidad). Para un bot público, valora bajar
# a Sonnet 5 o Haiku 4.5 para reducir coste — se cambia solo esta línea.
#
#   Modelo (Anthropic)   Precio $/1M (in / out)   Cuándo
#   claude-opus-5        5.00 / 25.00             Máxima calidad
#   claude-sonnet-5      2.00 / 10.00             Equilibrio calidad/coste (recomendado bot público)
#   claude-haiku-4-5     1.00 / 5.00              Más barato y rápido
#
# Si usas OpenAI, pon aquí el id del modelo de OpenAI (p. ej. gpt-4o-mini).
LLM_MODEL=claude-opus-5

# Máximo de tokens de salida por respuesta.
LLM_MAX_TOKENS=1200

# ── Claves (rellena solo la del proveedor que uses) ──────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── CORS: dominios permitidos (coma-separados) ───────────────────────────────
# 5500 = frontend estático en dev; 8000 = alternativo; el resto = producción.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000,https://adrian-cajas-portfolio.web.app

# Idioma por defecto ("es" o "en").
DEFAULT_LANG=es

# ── Guardarraíles de coste / abuso ───────────────────────────────────────────
MAX_INPUT_CHARS=1500
RATE_LIMIT_PER_MIN=8
RATE_LIMIT_PER_DAY=100
